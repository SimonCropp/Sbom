<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A package with a realistic dependency load, for comparing SBOM generators. BenchmarkMode picks
    the generator: None (baseline), Microsoft (Microsoft.Sbom.Targets) or Sbom.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Authors>Acme</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NuGetAudit>false</NuGetAudit>
    <GenerateSBOM Condition="'$(BenchmarkMode)' == 'Microsoft'">true</GenerateSBOM>
  </PropertyGroup>
  <ItemGroup Condition="'$(BenchmarkMode)' == 'Sbom'">
    <PackageReference Include="Sbom" Version="$(SbomVersion)" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(BenchmarkMode)' == 'Microsoft'">
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="MassTransit" Version="9.2.2" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NodaTime" Version="3.3.4" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <PackageReference Include="Quartz" Version="4.1.1" />
    <PackageReference Include="Refit" Version="16.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>
</Project>

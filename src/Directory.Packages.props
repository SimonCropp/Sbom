    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.9.6" Pinned="true" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.190" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="Verify" Version="33.6.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.6.0" />
  </ItemGroup>
</Project>